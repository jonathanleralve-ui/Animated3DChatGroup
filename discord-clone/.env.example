# Copy this file to .env and adjust as needed if running the app directly
# with `npm start` against a locally running Postgres (instead of docker compose).

PORT=3000
JWT_SECRET=dev-secret-change-me-in-production

PGHOST=localhost
PGPORT=5432
PGUSER=chatter
PGPASSWORD=chatter
PGDATABASE=chatter

# Alternatively, set a single connection string instead of the PG* vars above:
# DATABASE_URL=postgres://chatter:chatter@localhost:5432/chatter

# Powers the "play <song>" voice command (searches YouTube for a video to
# play in the call). Get one at https://console.cloud.google.com/apis/credentials
# after enabling the "YouTube Data API v3" on a project. Optional - the
# command just won't work without it.
YOUTUBE_API_KEY=AIzaSyB5KzVrRKiIJg_W5WXxne2vXfSjFAZQ1jA
